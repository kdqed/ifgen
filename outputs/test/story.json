          "text_romaji": "Oto no h\u014dk\u014d e iku",
          "text_kannada": "\u0cb6\u0cac\u0ccd\u0ca6\u0ca6 \u0ca6\u0cbf\u0c95\u0ccd\u0c95\u0cbf\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",
          "destination_id": 10
