{
  "title_japanese": "\u6642\u306e\u65c5\u4eba",
  "title_romaji": "Toki no Tabibito",
  "title_kannada": "\u0c95\u0cbe\u0cb2\u0ca6 \u0caf\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf\u0c95",
  "nodes": [
    {
      "id": 1,
      "title_japanese": "\u59cb\u307e\u308a\u306e\u68ee",
      "title_romaji": "Hajimari no Mori",
      "title_kannada": "\u0c86\u0cb0\u0c82\u0cad\u0ca6 \u0c85\u0cb0\u0ca3\u0ccd\u0caf",
      "texts": [
        {
          "text_japanese": "\u3042\u306a\u305f \u306f \u53e4\u3044 \u68ee \u306e \u5965 \u306b \u7acb\u3063\u3066\u3044\u307e\u3059\u3002",
          "text_romaji": "Anata wa furui mori no oku ni tatte imasu.",
          "text_kannada": "\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb9\u0cb3\u0cc6\u0caf \u0c85\u0cb0\u0ca3\u0ccd\u0caf\u0ca6 \u0c92\u0cb3\u0c97\u0cc6 \u0ca8\u0cbf\u0c82\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf."
        },
        {
          "text_japanese": "\u592a\u967d \u306e \u5149 \u304c \u8449 \u3092 \u901a\u3057\u3066 \u5dee\u3057\u8fbc\u3093\u3067 \u3044\u307e\u3059\u3002",
          "text_romaji": "Taiy\u014d no hikari ga ha o t\u014dshite sashikonde imasu.",
          "text_kannada": "\u0cb8\u0cc2\u0cb0\u0ccd\u0caf\u0ca8 \u0cac\u0cc6\u0cb3\u0c95\u0cc1 \u0c8e\u0cb2\u0cc6\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0cac\u0cc0\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u9053 \u306f \u4e8c\u3064 \u306b \u5206\u304b\u308c\u3066\u3044\u307e\u3059\u3002",
          "text_romaji": "Michi wa futatsu ni wakarete imasu.",
          "text_kannada": "\u0ca6\u0cbe\u0cb0\u0cbf\u0caf\u0cc1 \u0c8e\u0cb0\u0ca1\u0c95\u0ccd\u0c95\u0cc6 \u0cac\u0cc7\u0cb0\u0ccd\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u5de6 \u306e \u5c0f\u9053 \u3092 \u9032\u3080",
          "text_romaji": "Hidari no komichi o susumu",
          "text_kannada": "\u0c8e\u0ca1\u0ca6 \u0c95\u0cbf\u0cb0\u0cbf\u0ca6\u0cbe\u0ca6 \u0cb9\u0cbe\u0ca6\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf",
          "destination_id": 2
        },
        {
          "text_japanese": "\u53f3 \u306e \u5927\u304d\u306a \u9053 \u3092 \u9032\u3080",
          "text_romaji": "Migi no \u014dkina michi o susumu",
          "text_kannada": "\u0cac\u0cb2\u0ca6 \u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0cb9\u0cbe\u0ca6\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf",
          "destination_id": 3
        }
      ]
    },
    {
      "id": 2,
      "title_japanese": "\u9759\u304b\u306a\u6edd",
      "title_romaji": "Shizukana Taki",
      "title_kannada": "\u0cb6\u0cbe\u0c82\u0ca4 \u0c9c\u0cb2\u0caa\u0cbe\u0ca4",
      "texts": [
        {
          "text_japanese": "\u5c0f\u9053 \u306f \u9759\u304b\u306a \u6edd \u306b \u7d9a\u3044\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "Komichi wa shizukana taki ni tsuzuite imasu.",
          "text_kannada": "\u0c95\u0cbf\u0cb0\u0cbf\u0ca6\u0cbe\u0ca6 \u0cb9\u0cbe\u0ca6\u0cbf\u0caf\u0cc1 \u0cb6\u0cbe\u0c82\u0ca4 \u0c9c\u0cb2\u0caa\u0cbe\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u6edd\u306e\u88cf\u306b\u6d1e\u7a9f\u304c\u3042\u308a\u307e\u3059\u3002",
          "text_romaji": "Taki no ura ni d\u014dkutsu ga arimasu.",
          "text_kannada": "\u0c9c\u0cb2\u0caa\u0cbe\u0ca4\u0ca6 \u0cb9\u0cbf\u0c82\u0ca6\u0cc6 \u0c97\u0cc1\u0cb9\u0cc6\u0caf\u0cbf\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u6edd \u306e \u88cf \u306e \u6d1e\u7a9f \u3092 \u63a2\u7d22 \u3059\u308b",
          "text_romaji": "Taki no ura no d\u014dkutsu o tansaku suru",
          "text_kannada": "\u0c9c\u0cb2\u0caa\u0cbe\u0ca4\u0ca6 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0c97\u0cc1\u0cb9\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cbf",
          "destination_id": 4
        },
        {
          "text_japanese": "\u68ee \u306b \u623b\u308b",
          "text_romaji": "Mori ni modoru",
          "text_kannada": "\u0c85\u0cb0\u0ca3\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 1
        }
      ]
    },
    {
      "id": 3,
      "title_japanese": "\u53e4\u3044\u6a4b",
      "title_romaji": "Furui Hashi",
      "title_kannada": "\u0cb9\u0cb3\u0cc6\u0caf \u0cb8\u0cc7\u0ca4\u0cc1\u0cb5\u0cc6",
      "texts": [
        {
          "text_japanese": "\u5927\u304d\u306a \u9053 \u306f \u53e4\u3044 \u77f3\u6a4b \u306b \u7d9a\u3044\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "\u014ckina michi wa furui ishibashi ni tsuzuite imasu.",
          "text_kannada": "\u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0cb9\u0cbe\u0ca6\u0cbf\u0caf\u0cc1 \u0cb9\u0cb3\u0cc6\u0caf \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0cb8\u0cc7\u0ca4\u0cc1\u0cb5\u0cc6\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u6a4b \u306e \u5411\u3053\u3046\u5074 \u306b \u6751 \u304c \u898b\u3048\u307e\u3059\u3002",
          "text_romaji": "Hashi no muk\u014dgawa ni mura ga miemasu.",
          "text_kannada": "\u0cb8\u0cc7\u0ca4\u0cc1\u0cb5\u0cc6\u0caf \u0c86\u0c9a\u0cc6\u0c97\u0cc6 \u0cb9\u0cb3\u0ccd\u0cb3\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cc1 \u0c95\u0cbe\u0ca3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u6a4b \u3092 \u6e21\u3063\u3066 \u6751 \u3078 \u884c\u304f",
          "text_romaji": "Hashi o watatte mura e iku",
          "text_kannada": "\u0cb8\u0cc7\u0ca4\u0cc1\u0cb5\u0cc6 \u0ca6\u0cbe\u0c9f\u0cbf \u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",
          "destination_id": 5
        },
        {
          "text_japanese": "\u68ee \u306b \u623b\u308b",
          "text_romaji": "Mori ni modoru",
          "text_kannada": "\u0c85\u0cb0\u0ca3\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 1
        }
      ]
    },
    {
      "id": 4,
      "title_japanese": "\u6642\u9593\u306e\u6d1e\u7a9f",
      "title_romaji": "Jikan no D\u014dkutsu",
      "title_kannada": "\u0c95\u0cbe\u0cb2\u0ca6 \u0c97\u0cc1\u0cb9\u0cc6",
      "texts": [
        {
          "text_japanese": "\u6d1e\u7a9f \u306e \u4e2d \u306f \u4e0d\u601d\u8b70 \u306a \u5149 \u3067 \u6e80\u305f\u3055\u308c\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "D\u014dkutsu no naka wa fushigina hikari de mitasarete imasu.",
          "text_kannada": "\u0c97\u0cc1\u0cb9\u0cc6\u0caf \u0c92\u0cb3\u0c97\u0cc6 \u0c85\u0ca6\u0ccd\u0cad\u0cc1\u0ca4 \u0cac\u0cc6\u0cb3\u0c95\u0cbf\u0ca8\u0cbf\u0c82\u0ca6 \u0ca4\u0cc1\u0c82\u0cac\u0cbf\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u4e2d\u592e \u306b \u53e4\u3044 \u6642\u8a08 \u304c \u3042\u308a\u307e\u3059\u3002",
          "text_romaji": "Ch\u016b\u014d ni furui tokei ga arimasu.",
          "text_kannada": "\u0cae\u0ca7\u0ccd\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cb3\u0cc6\u0caf \u0c98\u0ca1\u0cbf\u0caf\u0cbe\u0cb0\u0cb5\u0cbf\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u6642\u8a08 \u3092 \u8abf\u3079\u308b",
          "text_romaji": "Tokei o shiraberu",
          "text_kannada": "\u0c98\u0ca1\u0cbf\u0caf\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",
          "destination_id": 6
        },
        {
          "text_japanese": "\u6edd \u306b \u623b\u308b",
          "text_romaji": "Taki ni modoru",
          "text_kannada": "\u0c9c\u0cb2\u0caa\u0cbe\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 2
        }
      ]
    },
    {
      "id": 5,
      "title_japanese": "\u5e73\u548c\u306a\u6751",
      "title_romaji": "Heiwana Mura",
      "title_kannada": "\u0cb6\u0cbe\u0c82\u0ca4\u0cbf\u0caf\u0cc1\u0ca4 \u0c97\u0ccd\u0cb0\u0cbe\u0cae",
      "texts": [
        {
          "text_japanese": "\u6751\u4eba\u305f\u3061 \u306f \u3042\u306a\u305f \u3092 \u6b53\u8fce \u3057\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "Murabitotachi wa anata o kangei shite imasu.",
          "text_kannada": "\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0cb8\u0ccd\u0ca5\u0cb0\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6."
        },
        {
          "text_japanese": "\u5e83\u5834 \u306b \u6642\u9593 \u306b\u3064\u3044\u3066 \u306e \u5642 \u304c \u3042\u308a\u307e\u3059\u3002",
          "text_romaji": "Hiroba ni jikan ni tsuite no uwasa ga arimasu.",
          "text_kannada": "\u0c9a\u0ccc\u0c95\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cae\u0caf\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cb5\u0ca6\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cbf\u0cb5\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u6751\u4eba \u3068 \u8a71\u3059",
          "text_romaji": "Murabito to hanasu",
          "text_kannada": "\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0cb8\u0ccd\u0ca5\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ca8\u0cbe\u0ca1\u0cbf",
          "destination_id": 7
        },
        {
          "text_japanese": "\u6a4b \u306b \u623b\u308b",
          "text_romaji": "Hashi ni modoru",
          "text_kannada": "\u0cb8\u0cc7\u0ca4\u0cc1\u0cb5\u0cc6\u0c97\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 3
        }
      ]
    },
    {
      "id": 6,
      "title_japanese": "\u6642\u9593\u306e\u72ed\u9593",
      "title_romaji": "Jikan no Hazama",
      "title_kannada": "\u0c95\u0cbe\u0cb2\u0ca6 \u0c85\u0c82\u0ca4\u0cb0",
      "texts": [
        {
          "text_japanese": "\u6642\u8a08 \u306f \u52d5\u304d\u51fa\u3057\u3001 \u3042\u306a\u305f \u3092 \u904e\u53bb \u3078 \u3068 \u9001\u308a \u307e\u3059\u3002",
          "text_romaji": "Tokei wa ugokidashi, anata o kako e to okuri masu.",
          "text_kannada": "\u0c98\u0ca1\u0cbf\u0caf\u0cbe\u0cb0\u0cb5\u0cc1 \u0c9a\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf, \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cad\u0cc2\u0ca4\u0c95\u0cbe\u0cb2\u0c95\u0ccd\u0c95\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u76ee \u3092 \u899a\u307e\u3059 \u3068\u3001 \u898b\u77e5\u3089\u306c \u6642\u4ee3 \u306b \u3044\u307e\u3059\u3002",
          "text_romaji": "Me o samasu to, mishiranu jidai ni imasu.",
          "text_kannada": "\u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cb5\u0cbe\u0ca6\u0cbe\u0c97, \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c85\u0caa\u0cb0\u0cbf\u0c9a\u0cbf\u0ca4 \u0c95\u0cbe\u0cb2\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u672a\u6765 \u3078 \u9032\u3080",
          "text_romaji": "Mirai e susumu",
          "text_kannada": "\u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0ca4\u0ccd\u0ca4\u0cbf\u0ca8\u0cc6\u0ca1\u0cc6\u0c97\u0cc6 \u0cb8\u0cbe\u0c97\u0cbf",
          "destination_id": 8
        },
        {
          "text_japanese": "\u73fe\u5728 \u3078 \u623b\u308b",
          "text_romaji": "Genzai e modoru",
          "text_kannada": "\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 1
        }
      ]
    },
    {
      "id": 7,
      "title_japanese": "\u6614\u306e\u7269\u8a9e",
      "title_romaji": "Mukashi no Monogatari",
      "title_kannada": "\u0cb9\u0cb3\u0cc6\u0caf \u0c95\u0ca5\u0cc6",
      "texts": [
        {
          "text_japanese": "\u6751\u4eba \u306f \u53e4\u3044 \u6642\u8a08 \u306e \u4f1d\u8aac \u3092 \u8a71\u3057 \u307e\u3059\u3002",
          "text_romaji": "Murabito wa furui tokei no densetsu o hanashimasu.",
          "text_kannada": "\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0cb8\u0ccd\u0ca5\u0cb0\u0cc1 \u0cb9\u0cb3\u0cc6\u0caf \u0c98\u0ca1\u0cbf\u0caf\u0cbe\u0cb0\u0ca6 \u0ca6\u0c82\u0ca4\u0c95\u0ca5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6."
        },
        {
          "text_japanese": "\u305d\u308c\u306f \u6edd \u306e \u88cf \u306e \u6d1e\u7a9f \u306b \u3042\u308b \u305d\u3046\u3067\u3059\u3002",
          "text_romaji": "Sore wa taki no ura no d\u014dkutsu ni aru s\u014d desu.",
          "text_kannada": "\u0c85\u0ca6\u0cc1 \u0c9c\u0cb2\u0caa\u0cbe\u0ca4\u0ca6 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0c97\u0cc1\u0cb9\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb9\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u6edd \u3078 \u884c\u304f",
          "text_romaji": "Taki e iku",
          "text_kannada": "\u0c9c\u0cb2\u0caa\u0cbe\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",
          "destination_id": 2
        },
        {
          "text_japanese": "\u6751 \u3092 \u63a2\u7d22 \u3059\u308b",
          "text_romaji": "Mura o tansaku suru",
          "text_kannada": "\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cbf",
          "destination_id": 9
        }
      ]
    },
    {
