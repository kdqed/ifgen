      "title_japanese": "\u6751\u306e\u56f3\u66f8\u9928",
      "title_romaji": "Mura no Toshokan",
      "title_kannada": "\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0ca6 \u0c97\u0ccd\u0cb0\u0c82\u0ca5\u0cbe\u0cb2\u0caf",
      "texts": [
        {
          "text_japanese": "\u56f3\u66f8\u9928 \u3067 \u53e4\u3044 \u5dfb\u7269 \u3092 \u898b\u3064\u3051\u307e\u3057\u305f\u3002",
          "text_romaji": "Toshokan de furui makimono o mitsukemashita.",
          "text_kannada": "\u0c97\u0ccd\u0cb0\u0c82\u0ca5\u0cbe\u0cb2\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cb3\u0cc6\u0caf \u0cb8\u0cc1\u0cb0\u0cc1\u0cb3\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0cb0\u0cbf."
        },
        {
          "text_japanese": "\u305d\u308c \u306f \u6642\u9593 \u306e \u65c5 \u306b\u3064\u3044\u3066 \u66f8\u304b\u308c\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "Sore wa jikan no tabi ni tsuite kakarete imasu.",
          "text_kannada": "\u0c85\u0ca6\u0cc1 \u0cb8\u0cae\u0caf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cac\u0cb0\u0cc6\u0caf\u0cb2\u0ccd\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u5dfb\u7269 \u3092 \u8aad\u3080",
          "text_romaji": "Makimono o yomu",
          "text_kannada": "\u0cb8\u0cc1\u0cb0\u0cc1\u0cb3\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c93\u0ca6\u0cbf",
          "destination_id": 11
        },
        {
          "text_japanese": "\u6751 \u306e \u5e83\u5834 \u306b \u623b\u308b",
          "text_romaji": "Mura no hiroba ni modoru",
          "text_kannada": "\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0ca6 \u0c9a\u0ccc\u0c95\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 5
        }
      ]
    },
    {
      "id": 10,
      "title_japanese": "\u6642\u9593\u4fee\u5fa9\u88c5\u7f6e",
      "title_romaji": "Jikan Sh\u016bfuku S\u014dchi",
      "title_kannada": "\u0c95\u0cbe\u0cb2 \u0ca6\u0cc1\u0cb0\u0cb8\u0ccd\u0ca4\u0cbf \u0cb8\u0cbe\u0ca7\u0ca8",
      "texts": [
        {
          "text_japanese": "\u97f3 \u306e \u6e90 \u306f \u5de8\u5927 \u306a \u6a5f\u68b0 \u3067\u3057\u305f\u3002",
          "text_romaji": "Oto no minamoto wa kyodai na kikai deshita.",
          "text_kannada": "\u0cb6\u0cac\u0ccd\u0ca6\u0ca6 \u0cae\u0cc2\u0cb2\u0cb5\u0cc1 \u0c92\u0c82\u0ca6\u0cc1 \u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0cb5\u0cbe\u0c97\u0cbf\u0ca4\u0ccd\u0ca4\u0cc1."
        },
        {
          "text_japanese": "\u305d\u308c \u306f \u6642\u9593 \u306e \u6d41\u308c \u3092 \u5b89\u5b9a \u3055\u305b\u308b \u305f\u3081 \u306e \u3082\u306e \u3067\u3059\u3002",
          "text_romaji": "Sore wa jikan no nagare o antei saseru tame no mono desu.",
          "text_kannada": "\u0c85\u0ca6\u0cc1 \u0c95\u0cbe\u0cb2\u0ca6 \u0cb9\u0cb0\u0cbf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0ca5\u0cbf\u0cb0\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u6a5f\u68b0 \u3092 \u64cd\u4f5c \u3059\u308b",
          "text_romaji": "Kikai o s\u014dsa suru",
          "text_kannada": "\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf",
          "destination_id": 12
        },
        {
          "text_japanese": "\u672a\u6765 \u90fd\u5e02 \u3092 \u63a2\u7d22 \u3059\u308b",
          "text_romaji": "Mirai toshi o tansaku suru",
          "text_kannada": "\u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0ca6 \u0ca8\u0c97\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cbf",
          "destination_id": 8
        }
      ]
    },
    {
      "id": 11,
      "title_japanese": "\u5931\u308f\u308c\u305f\u77e5\u8b58",
      "title_romaji": "Ushinawareta Chishiki",
      "title_kannada": "\u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0cb9\u0ccb\u0ca6 \u0c9c\u0ccd\u0c9e\u0cbe\u0ca8",
      "texts": [
        {
          "text_japanese": "\u5dfb\u7269 \u306b \u306f\u3001 \u6642\u9593 \u304c \u58ca\u308c\u3066 \u3044\u308b \u3068 \u66f8\u304b\u308c\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "Makimono ni wa, jikan ga kowarete iru to kakarete imasu.",
          "text_kannada": "\u0cb8\u0cc1\u0cb0\u0cc1\u0cb3\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf, \u0cb8\u0cae\u0caf\u0cb5\u0cc1 \u0cb9\u0cbe\u0cb3\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0cac\u0cb0\u0cc6\u0caf\u0cb2\u0ccd\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u305d\u3057\u3066\u3001 \u305d\u308c \u3092 \u4fee\u5fa9 \u3059\u308b \u65b9\u6cd5 \u3082\u3002",
          "text_romaji": "Soshite, sore o sh\u016bfuku suru h\u014dh\u014d mo.",
          "text_kannada": "\u0cae\u0ca4\u0ccd\u0ca4\u0cc1, \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0cc1\u0cb0\u0cb8\u0ccd\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0cc2."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u672a\u6765 \u3078 \u884c\u304f",
          "text_romaji": "Mirai e iku",
          "text_kannada": "\u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",
          "destination_id": 8
        },
        {
          "text_japanese": "\u6d1e\u7a9f \u3078 \u623b\u308b",
          "text_romaji": "D\u014dkutsu e modoru",
          "text_kannada": "\u0c97\u0cc1\u0cb9\u0cc6\u0c97\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 4
        }
      ]
    },
    {
      "id": 12,
      "title_japanese": "\u6642\u9593\u306e\u4fee\u5fa9",
      "title_romaji": "Jikan no Sh\u016bfuku",
      "title_kannada": "\u0c95\u0cbe\u0cb2\u0ca6 \u0ca6\u0cc1\u0cb0\u0cb8\u0ccd\u0ca4\u0cbf",
      "texts": [
        {
          "text_japanese": "\u6a5f\u68b0 \u3092 \u64cd\u4f5c \u3059\u308b\u3068\u3001 \u6642\u9593 \u304c \u5143 \u306b \u623b\u308a\u59cb\u3081\u307e\u3059\u3002",
          "text_romaji": "Kikai o s\u014dsa suru to, jikan ga moto ni modorihajimemasu.",
          "text_kannada": "\u0ca8\u0cc0\u0cb5\u0cc1 \u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6\u0cbe\u0c97, \u0cb8\u0cae\u0caf\u0cb5\u0cc1 \u0cb8\u0cb9\u0c9c \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0c97\u0cc6 \u0cae\u0cb0\u0cb3\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
        },
        {
          "text_japanese": "\u4e16\u754c \u306f \u660e\u308b\u3055 \u3092 \u53d6\u308a\u623b\u3057\u307e\u3059\u3002",
          "text_romaji": "Sekai wa akarusa o torimodoshimasu.",
          "text_kannada": "\u0caa\u0ccd\u0cb0\u0caa\u0c82\u0c9a\u0cb5\u0cc1 \u0c85\u0ca6\u0cb0 \u0cb9\u0cca\u0cb3\u0caa\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cb3\u0cbf \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u73fe\u5728 \u306b \u623b\u308b",
          "text_romaji": "Genzai ni modoru",
          "text_kannada": "\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf",
          "destination_id": 13
        },
        {
          "text_japanese": "\u672a\u6765 \u306b \u7559\u307e\u308b",
          "text_romaji": "Mirai ni tomaru",
          "text_kannada": "\u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c89\u0cb3\u0cbf\u0caf\u0cbf\u0cb0\u0cbf",
          "destination_id": 14
        }
      ]
    },
    {
      "id": 13,
      "title_japanese": "\u5e73\u548c\u306a\u73fe\u5728",
      "title_romaji": "Heiwana Genzai",
      "title_kannada": "\u0cb6\u0cbe\u0c82\u0ca4\u0cbf\u0caf\u0cc1\u0ca4 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4",
      "texts": [
        {
          "text_japanese": "\u3042\u306a\u305f \u306f \u68ee \u306b \u623b\u3063\u3066 \u304d\u307e\u3057\u305f\u3002",
          "text_romaji": "Anata wa mori ni modotte kimashita.",
          "text_kannada": "\u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0cb0\u0ca3\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cb3\u0cbf \u0cac\u0c82\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf."
        },
        {
          "text_japanese": "\u3059\u3079\u3066 \u304c \u4ee5\u524d \u3088\u308a \u9bae\u3084\u304b \u3067\u3059\u3002",
          "text_romaji": "Subete ga izen yori azayaka desu.",
          "text_kannada": "\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0cc2 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0c97\u0cbf\u0c82\u0ca4\u0cb2\u0cc2 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0cb5\u0cb0\u0ccd\u0ca3\u0cae\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb5\u0cc6."
        },
        {
          "text_japanese": "\u3042\u306a\u305f \u306e \u5192\u967a \u306f \u7d42\u308f\u308a \u307e\u3057\u305f\u3002",
          "text_romaji": "Anata no b\u014dken wa owarimashita.",
          "text_kannada": "\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cbe\u0cb9\u0cb8\u0cb5\u0cc1 \u0c95\u0cca\u0ca8\u0cc6\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca4\u0cc1."
        }
      ],
      "actions": [
        {
          "text_japanese": "\u65b0\u3057\u3044 \u5192\u967a \u3092 \u59cb\u3081\u308b",
          "text_romaji": "Atarashii b\u014dken o hajimeru",
          "text_kannada": "\u0cb9\u0cca\u0cb8 \u0cb8\u0cbe\u0cb9\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf",
          "destination_id": 1
        },
        {
          "text_japanese": "\u7269\u8a9e \u3092 \u7d42\u3048\u308b",
          "text_romaji": "Monogatari o oeru",
          "text_kannada": "\u0c95\u0ca5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cbf",
          "destination_id": 20
        }
      ]
    },
    {
