      "title_japanese": "\u8352\u5ec3\u3057\u305f\u672a\u6765\u90fd\u5e02",
      "title_romaji": "K\u014dhai shita Mirai Toshi",
      "title_kannada": "\u0cb5\u0cbf\u0ca7\u0ccd\u0cb5\u0c82\u0cb8\u0c97\u0cca\u0c82\u0ca1 \u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0ca6 \u0ca8\u0c97\u0cb0",
      "texts": [
        {
          "text_japanese": "\u8857 \u306f \u8352\u5ec3 \u3057\u3066 \u3044\u307e\u3059\u3002",
          "text_romaji": "Machi wa k\u014dhai shite imasu.",
          "text_kannada": "\u0ca8\u0c97\u0cb0\u0cb5\u0cc1 \u0cb5\u0cbf\u0ca7\u0ccd\u0cb5\u0c82\u0cb8\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6."
        },
        {
